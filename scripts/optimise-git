#! /bin/sh

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

success() {
    printf '\n\033[32m✓\033[0m %s\n' "$*"
}

info() {
    printf '\n\033[32m→\033[0m %s\n' "$*"
}

MARKER_FILE=$1
[ -z "$MARKER_FILE" ] && die "Marker file not specified"

RUN_WEEKLY=0
if [ "$GIT_OPTIMIZE_DAY" = "$(date +%u)" ]; then
  if [ ! -f "$MARKER_FILE" ]; then
    info "Weekly optimisation will run today"
    RUN_WEEKLY=1
    touch "$MARKER_FILE" || die "Could not create marker file $MARKER_FILE"
  else
    info "Weekly optimisation already run today"
  fi
else
  info "Weekly optimisation not scheduled today"
  rm -f "$MARKER_FILE"
fi

for CURRENT_DIR in $(find /local/work/* -name '*.git' -print | sed "s|/.git$||" | sort -u | grep -v .cache)
do
  info "Optimising $CURRENT_DIR..."

  info "Clearing locks..."
  find "$CURRENT_DIR/.git" -name "*.lock" -delete

  info "Cleaning working tree..."
  git -C "$CURRENT_DIR" clean -fdx

  if [ "$RUN_WEEKLY" = 1 ]; then
    info "Pruning remotes..."
    for REMOTE in $(git -C "$CURRENT_DIR" remote)
    do
      info "Pruning $REMOTE..."
      git -C "$CURRENT_DIR" remote prune "$REMOTE"
    done

    info "Expiring reflog..."
    git -C "$CURRENT_DIR" reflog expire --expire=1.month.ago --all
    info "Garbage collecting..."
    git -C "$CURRENT_DIR" gc --prune=now --force --quiet
  fi

done

success "Repo optimisation completed"
