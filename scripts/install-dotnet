#! /bin/bash
# Requires die() and info() to be defined by the sourcing script.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    printf '\033[31m✗\033[0m install-dotnet must be sourced, not executed directly\n' >&2
    exit 1
fi

DOWNLOADS=$HOME/downloads
TMPBASE=${TMPDIR:-$HOME/tmp}
[ -d "$TMPBASE" ] || mkdir -p "$TMPBASE"
[ -d "$DOWNLOADS" ] || mkdir -p "$DOWNLOADS"

temporary_file_template="$TMPBASE/dotnet.XXXXXXXXX"
override_non_versioned_files=true
verbose=0

[ -z "$DOTNET_SOURCE" ] && export DOTNET_SOURCE=https://builds.dotnet.microsoft.com
[ -z "$DOTNET_PROXY_HOST" ] && export DOTNET_PROXY_HOST=https://dotnet.markridgwell.com

[ -z "$DOTNET_SOURCE" ] && die "DOTNET_SOURCE not defined"
[ -z "$DOTNET_PROXY_HOST" ] && die "DOTNET_PROXY_HOST not defined"

USER_AGENT="DotnetVersionChecker/1.0.0"

say() {
    info "dotnet-install: $1"
}

say_verbose() {
    if [ "$verbose" = true ]; then
        say "$1"
    fi
}

# args:
# zip_path - $1
# out_path - $2
extract_dotnet_package() {
    local zip_path="$1"
    local out_path="$2"

    local temp_out_path
    temp_out_path="$(mktemp -d "$temporary_file_template")"

    info "Extracting..."
    local failed=false
    tar -xvzf "$zip_path" -C "$temp_out_path" > /dev/null || failed=true

    if [ "$failed" = true ]; then
      sudo rm -f "$zip_path" && say_verbose "Temporary archive file $zip_path was removed"
      die "Extraction failed"
    fi

    info "Installing..."
    local folders_with_version_regex='^.*/[0-9]+\.[0-9]+[^/]+/'
    find "$temp_out_path" -type f | grep -Eo "$folders_with_version_regex" | sort | copy_files_or_dirs_from_list "$temp_out_path" "$out_path" false
    find "$temp_out_path" -type f | grep -Ev "$folders_with_version_regex" | copy_files_or_dirs_from_list "$temp_out_path" "$out_path" "$override_non_versioned_files"

    sudo rm -rf "$temp_out_path"

    if [ ! -f "$out_path/dotnet" ]; then
        die "Extraction failed: dotnet binary missing at $out_path/dotnet"
    fi
    return 0
}

# args:
# input_files - stdin
# root_path - $1
# out_path - $2
# override - $3
copy_files_or_dirs_from_list() {
    local root_path
    root_path="$(remove_trailing_slash "$1")"
    local out_path
    out_path="$(remove_trailing_slash "$2")"
    local override="$3"
    local override_switch
    override_switch="$(get_cp_options "$override")"

    cat | uniq | while read -r file_path; do
        local path
        path="$(remove_beginning_slash "${file_path#"$root_path"}")"
        local target="$out_path/$path"
        if [ "$override" = true ] || ! { [ -d "$target" ] || [ -e "$target" ]; }; then
            sudo mkdir -p "$out_path/$(dirname "$path")"
            if [ -d "$target" ]; then
                sudo rm -rf "$target"
            fi
            # shellcheck disable=SC2086
            sudo cp -R $override_switch "$root_path/$path" "$target"
        fi
    done
}

# args:
# override - $1 (boolean, true or false)
get_cp_options() {
    local override="$1"
    local override_switch=""

    if [ "$override" = false ]; then
        override_switch="-n"

        local tmp_dir
        tmp_dir="$(sudo mktemp -d)"
        local tmp_file="$tmp_dir/testfile"
        local tmp_file2="$tmp_dir/testfile2"

        sudo touch "$tmp_file"

        if sudo cp -u "$tmp_file" "$tmp_file2" 2>/dev/null; then
            override_switch="-u"
        fi

        sudo rm -f "$tmp_file" "$tmp_file2"
        sudo rm -rf "$tmp_dir"
    fi

    echo "$override_switch"
}


# args:
# input - $1
remove_trailing_slash() {
    local input="${1:-}"
    echo "${input%/}"
    return 0
}

# args:
# input - $1
remove_beginning_slash() {
    local input="${1:-}"
    echo "${input#/}"
    return 0
}

# args:
# version - $1
# sdk version - $2
install_dotnet_version() {
  local VERSION="$1"
  local SDK_VERSION="$2"

  info "Installing dotnet: $VERSION (SDK: $SDK_VERSION)"

  if [ -f "$DOTNET_ROOT/dotnet" ]; then
    local SDK_INSTALLED
    SDK_INSTALLED=$("$DOTNET_ROOT/dotnet" --list-sdks | cut -f 1 -d " " | grep -F "$SDK_VERSION")

    if [ "$SDK_INSTALLED" = "$SDK_VERSION" ]; then
      info "Already installed - skipping"
      return
    else
      info "New install (previous installed): $SDK_VERSION"
    fi
  else
    info "New install (none installed): $SDK_VERSION"
  fi

  local TEMPORARY_FILE="$DOWNLOADS/$SDK_VERSION.tgz"

  if [ -f "$TEMPORARY_FILE" ]; then
    info "Already downloaded: $TEMPORARY_FILE"
  else
    local DOWNLOAD_URL="$DOTNET_PROXY_HOST/dotnet/Sdk/$SDK_VERSION/dotnet-sdk-$SDK_VERSION-linux-x64.tar.gz"
    info "Downloading: $DOWNLOAD_URL"
    curl \
         --max-time 120 \
         --retry 5 \
         --retry-delay 0 \
         --retry-max-time 600 \
         -s \
         -L \
         -f \
         --user-agent "$USER_AGENT" \
         "$DOWNLOAD_URL" \
          -o "$TEMPORARY_FILE" || die "Could not download: $DOWNLOAD_URL"

    [ -f "$TEMPORARY_FILE" ] || die "Temp file not downloaded ($DOWNLOAD_URL)"
   fi

   extract_dotnet_package "$TEMPORARY_FILE" "$DOTNET_ROOT" || die "Could not install"

   info "Installed SDKs:"
   "$DOTNET_ROOT/dotnet" --list-sdks || die "Dotnet $SDK_VERSION not installed properly (No dotnet)"

   [ -x "$DOTNET_ROOT/dotnet" ] || die "Dotnet $SDK_VERSION not installed properly (dotnet exe not installed)"
   local SDK_INSTALLED_NOW
   SDK_INSTALLED_NOW=$("$DOTNET_ROOT/dotnet" --list-sdks | cut -f 1 -d " " | grep -F "$SDK_VERSION")
   [ -z "$SDK_INSTALLED_NOW" ] && die "Dotnet $SDK_VERSION not installed properly (Found None)"
   [ "$SDK_INSTALLED_NOW" = "$SDK_VERSION" ] || die "Dotnet $SDK_VERSION not installed properly (Found $SDK_INSTALLED_NOW)"
}

get_latest_dotnet_sdk_version() {
    local DOTNET_CHANNEL_VERSION="$1"
    [ -z "$DOTNET_CHANNEL_VERSION" ] && die "Dotnet channel version not defined"
    curl \
       --max-time 120 \
       --retry 5 \
       --retry-delay 0 \
       --retry-max-time 600 \
       -s \
       -L \
       -f \
       --user-agent "$USER_AGENT" \
       https://dotnetcli.blob.core.windows.net/dotnet/release-metadata/releases-index.json |
    jq --arg v "$DOTNET_CHANNEL_VERSION" -r '
            ."releases-index"
            | map(select(."channel-version" | contains($v)))
            | first(.[])
          | ."latest-sdk"'
}
