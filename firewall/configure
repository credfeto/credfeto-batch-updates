#!/bin/sh

# Locks the dev-upgrader host's egress down, like the DNS servers.
# Deliberately separate from ../update (which runs every five minutes to keep
# the updaters current): run it by hand once as root (sudo firewall/configure);
# after that updater-firewall-sync.timer re-runs it whenever the firewall config
# in the checkout changes.
#
# The rules are one nftables table, inet upd_egress, built and loaded by
# firewall/egress (see there): host_out for what the host itself may connect
# to, docker_fwd for what the updater containers may connect to. The whole
# table, address sets included, is replaced in one nft transaction, so a
# refresh never reloads firewalld and a failed load keeps the previous rules.
# firewalld still owns the base zones; ingress needs nothing extra (the
# containers publish no ports, and SSH is the public zone's own rule set).
#
# UPDATER_FIREWALL_ENFORCE=true in ../.env is the single enforcement knob:
# unmatched new connections are dropped. Otherwise (the default) they still
# flow and are only logged, with the prefixes "upd-egress-unmatched: " and
# "upd-egress-docker-unmatched: ". The same rules serve both modes: run in
# observation mode, check the log for anything legitimate, then enforce.

set -eu

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

info() {
    printf '\n\033[32m→\033[0m %s\n' "$*"
}

[ "$(id -u)" -eq 0 ] || die "must run as root"

# One run at a time: the sync timer can fire while a manual run is still going,
# and concurrent firewall changes would trip over each other.
exec 9> /run/lock/credfeto-batch-updates-firewall.lock
flock 9

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/../.env"

env_value() {
    [ -f "${ENV_FILE}" ] || return 0
    grep -E "^[[:space:]]*$1[[:space:]]*=" "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//'
}

ENFORCE="false"
if [ "$(env_value UPDATER_FIREWALL_ENFORCE)" = "true" ]; then
    ENFORCE="true"
fi

# --- Retire the firewalld policies and ipsets an earlier version used. Their
# refresh reloaded firewalld every 10 minutes, and a firewalld killed
# mid-reload (for example by the OOM killer) leaves its block-everything table
# behind. One last reload removes them; after this nothing here reloads
# firewalld.
if command -v firewall-cmd > /dev/null 2>&1 && firewall-cmd --state > /dev/null 2>&1; then
    RETIRED=false
    for POLICY in upd-egress upd-egress-docker; do
        if firewall-cmd --permanent --info-policy="${POLICY}" > /dev/null 2>&1; then
            firewall-cmd --permanent --delete-policy="${POLICY}" > /dev/null || die "Failed to delete policy ${POLICY}"
            RETIRED=true
        fi
    done
    for IPSET in $(firewall-cmd --permanent --get-ipsets); do
        case "${IPSET}" in
            upd-egress-*)
                firewall-cmd --permanent --delete-ipset="${IPSET}" > /dev/null || die "Failed to delete ipset ${IPSET}"
                RETIRED=true
                ;;
        esac
    done
    if [ "${RETIRED}" = "true" ]; then
        info "Removing the old firewalld egress policies..."
        firewall-cmd --reload > /dev/null
    fi
fi
rm -f /usr/local/bin/updater-refresh-egress-ipsets

info "Configuring firewall (enforce ${ENFORCE})..."

# --- The egress table and its refresh timer ---
install -m 755 "${SCRIPT_DIR}/egress" /usr/local/bin/updater-egress
install -d -m 755 /usr/local/share/credfeto-batch-updates
install -m 644 "${SCRIPT_DIR}/github-egress-ranges" /usr/local/share/credfeto-batch-updates/github-egress-ranges
install -m 644 "${SCRIPT_DIR}/cloudflare-egress-ranges" /usr/local/share/credfeto-batch-updates/cloudflare-egress-ranges
install -m 644 "${SCRIPT_DIR}/updater-egress-refresh.service" /etc/systemd/system/updater-egress-refresh.service
install -m 644 "${SCRIPT_DIR}/updater-egress-refresh.timer" /etc/systemd/system/updater-egress-refresh.timer

# --- Keep the firewall in step with the checkout: firewall/sync re-runs this
# script when the firewall config changes (the checkout itself is kept current
# by ../update). A symlink, so the script finds the checkout it lives in.
ln -sfn "${SCRIPT_DIR}/sync" /usr/local/sbin/updater-firewall-sync
install -m 644 "${SCRIPT_DIR}/updater-firewall-sync.service" /etc/systemd/system/updater-firewall-sync.service
install -m 644 "${SCRIPT_DIR}/updater-firewall-sync.timer" /etc/systemd/system/updater-firewall-sync.timer

systemctl daemon-reload
for UNIT in updater-egress-refresh.timer updater-firewall-sync.timer; do
    systemctl enable "${UNIT}" > /dev/null 2>&1
    # restart, not just enable --now: an already-active timer keeps its old
    # schedule otherwise.
    systemctl restart "${UNIT}"
done
# Load the table now rather than at the timer's first run. Keep the paths in
# sync with firewall/egress.
install -d -m 755 /var/lib/credfeto-batch-updates
printf '%s\n' "${ENFORCE}" > /var/lib/credfeto-batch-updates/egress-enforce
/usr/local/bin/updater-egress

# Record the commit whose firewall config is now live; firewall/sync compares
# against it. Keep the path in sync with firewall/sync.
git -C "${SCRIPT_DIR}" rev-parse HEAD > /var/lib/credfeto-batch-updates/firewall-applied-head

info "Firewall configured (enforce ${ENFORCE})."
